<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods</OutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Overridable via -p:RfMechanicsDeployPath=... . Defaults to the Mods junction itself, not its
       target, so deploy follows whichever profile the junction points at without this file
       naming it (mirrors dietsetup's DietSetupDeployPath convention). -->
  <PropertyGroup>
    <RfMechanicsDeployPath Condition="'$(RfMechanicsDeployPath)' == ''">$(VINTAGE_STORY_DATA)\Mods\rfmechanics</RfMechanicsDeployPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Historical record only, superseded by PlayerRaceBehavior. The implicit SDK glob would
         otherwise compile everything under archive/ too. -->
    <Compile Remove="archive/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Client-only internals (Vintagestory.Client.NoObf.ClientMain) for the elf-zoom FOV transpiler. -->
    <Reference Include="VintagestoryLib">
      <HintPath>$(VINTAGE_STORY)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Stamps GitInfo.g.cs with the short SHA + dirty flag so a running build can log what it
       actually is (Phase A). git absent/unavailable -> "unknown", never a build failure. -->
  <Target Name="GenerateGitInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="RfMechanicsGitShaOutput" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="RfMechanicsGitStatusOutput" />
    </Exec>
    <PropertyGroup>
      <RfMechanicsGitSha Condition="'@(RfMechanicsGitShaOutput)' != ''">@(RfMechanicsGitShaOutput)</RfMechanicsGitSha>
      <RfMechanicsGitSha Condition="'$(RfMechanicsGitSha)' == ''">unknown</RfMechanicsGitSha>
      <RfMechanicsGitDirty Condition="'@(RfMechanicsGitStatusOutput)' != ''">true</RfMechanicsGitDirty>
      <RfMechanicsGitDirty Condition="'$(RfMechanicsGitDirty)' == ''">false</RfMechanicsGitDirty>
    </PropertyGroup>
    <ItemGroup>
      <RfMechanicsGitInfoLines Include="internal static class GitInfo" />
      <RfMechanicsGitInfoLines Include="{" />
      <RfMechanicsGitInfoLines Include="    public const string Sha = &quot;$(RfMechanicsGitSha)&quot;%3b" />
      <RfMechanicsGitInfoLines Include="    public const bool Dirty = $(RfMechanicsGitDirty)%3b" />
      <RfMechanicsGitInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)GitInfo.g.cs" Lines="@(RfMechanicsGitInfoLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GitInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Stages, mirrors to the client Mods folder, and (Release only) zips + copies to
       $(MOD_STAGING_PATH), all from the single exclude list owned by Package.ps1, so the
       client folder and the server zip can never diverge from each other (Phase A D1/D6). -->
  <Target Name="Deploy" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Package.ps1&quot; -Dll &quot;$(TargetPath)&quot; -Pdb &quot;$(TargetDir)$(TargetName).pdb&quot; -DeployPath &quot;$(RfMechanicsDeployPath)&quot; -StagingPath &quot;$(MOD_STAGING_PATH)&quot; -Configuration $(Configuration)" ContinueOnError="false" />
  </Target>

</Project>